{
	"name": "rmm-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node node_modules/vite/bin/vite.js dev",
		"build": "node node_modules/vite/bin/vite.js build",
		"preview": "node node_modules/vite/bin/vite.js preview",
		"prepare": "node node_modules/@sveltejs/kit/svelte-kit.js sync || echo ''",
		"check": "node node_modules/@sveltejs/kit/svelte-kit.js sync && node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
		"test:visual": "node node_modules/@playwright/test/cli.js test",
		"test:visual:docker": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e CI=1 -v \"$PWD\":/web -w /web mcr.microsoft.com/playwright:v1.65.0-noble node node_modules/@playwright/test/cli.js test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lezer/highlight": "^1.2.5",
		"@lucide/svelte": "^1.70.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0"
	}
}
