# URL agents and browsers use to reach the server. Use https:// behind a reverse proxy;
# plain http://<host-ip>:8080 is fine for a LAN test.
RMM_PUBLIC_URL=https://rmm.example.com
RMM_PORT=8080

# Wrap any value containing $ or # in 'single quotes': compose expands $VAR and
# treats ' #' as a comment in unquoted values, silently truncating passwords.

# Long random value, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# First admin login, created only when the database has no users yet.
# Remove both after you've signed in. Password must be at least 12 characters.
RMM_ADMIN_EMAIL=
RMM_ADMIN_PASSWORD=

# Reverse proxy address(es) whose X-Forwarded-For is trusted, as CIDRs, or `private` for
# loopback/RFC 1918 (a proxy on this host or Docker network). Leave empty if clients
# connect to the server directly.
RMM_TRUSTED_PROXIES=

# Database backups (the `backup` service). Dumps go to the rmm-backups volume.
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
