# URL agents and browsers use to reach the server. Use https:// behind a reverse proxy;
# plain http://<host-ip>:8080 is fine for a LAN test.
RMM_PUBLIC_URL=https://rmm.example.com
RMM_PORT=8080

# Long random value, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# First admin login, created only when the database has no users yet.
# Remove both after you've signed in. Password must be at least 12 characters.
RMM_ADMIN_EMAIL=
RMM_ADMIN_PASSWORD=
