RMM_DOMAIN=rmm.example.com
POSTGRES_PASSWORD=change-me-to-something-long
# Encrypts 2FA secrets and detection context in the database: `openssl rand -hex 32`.
# Keep a copy somewhere safe. Database backups are useless for those columns without it.
RMM_DATA_KEY=
# Database backups, written to deploy/backups/
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
